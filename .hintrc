{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/keyboard": [
      "default",
      {
        "nested-interactive": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "mask-image",
          "-webkit-overflow-scrolling"
        ]
      }
    ],
    "no-inline-styles": "off"
  }
}